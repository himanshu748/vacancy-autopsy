# This file contains names and safe defaults only. Copy to .env; never commit secrets.
HOST=127.0.0.1
PORT=8787
# Optional hosted mode requires full Auth0 + MongoDB and explicit deployment authorization.
# Remove HOST above or set HOST=0.0.0.0 only after configuring PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://your-service.onrender.com
# DATA_DIR=./data
# MONGODB_URI=
# MONGODB_DATABASE=vacancy_autopsy

# Optional local Temporal path; see docs/TEMPORAL.md.
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=vacancy-autopsy-investigations

# Model credentials stay on the server; extraction needs a completed project checkpoint.
# TABPFN_TOKEN=
# TABPFN_PRIORITY_CONTEXT=/private/path/to/model-context.json
# TABPFN_PYTHON=/private/path/to/priority-provider-env/bin/python
# TINKER_API_KEY=
# TINKER_PROJECT_ID=
# TINKER_EXTRACTOR_ARTIFACT=/private/path/to/training.json
# TINKER_PYTHON=/private/path/to/provider-env/bin/python
# TINKER_TOKENIZER_CACHE=/private/path/to/model-tokenizers
# Optional current-opening alternatives; requires its own approved project key.
# PAPERINSTRUMENTS_API_KEY=

# Optional source tools; no calls are made when these are absent.
# SERPAPI_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Private reviewer approval. All values must belong to this project.
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
# AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# Optional reviewed public snapshots. Keep off until sharing is explicitly authorized.
# Requires complete Auth0 configuration; never makes private reports public.
PUBLIC_SHARING_ENABLED=false

# Explicit, content-minimized backend workflow spans.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local

# Configuration is not live-provider proof. Public hosting remains blocked until
# every report/source endpoint has a reviewed authentication/isolation boundary.
