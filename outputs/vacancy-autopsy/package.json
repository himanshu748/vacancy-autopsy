{
  "name": "vacancy-autopsy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx src/server/index.ts",
    "temporal:worker": "tsx src/temporal/worker.ts",
    "test:recovery": "TEMPORAL_RECOVERY_TEST=1 tsx --test tests/temporal-recovery.integration.test.ts",
    "entire:install": "node scripts/entire.mjs --install",
    "entire:setup": "node scripts/configure-entire.mjs",
    "entire": "node scripts/entire.mjs",
    "entire:status": "node scripts/entire.mjs status --detailed"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@mastra/core": "^1.80.0",
    "@sentry/node": "^11.10.0",
    "@temporalio/activity": "~1.25.0",
    "@temporalio/client": "~1.25.0",
    "@temporalio/worker": "~1.25.0",
    "@temporalio/workflow": "~1.25.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "mongodb": "^7.7.0",
    "openai": "7.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
